# Public VAPID key used by the browser to create a push subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Private VAPID key used by the server to sign push messages. Never expose this.
VAPID_PRIVATE_KEY=

# Contact address included in VAPID requests.
VAPID_SUBJECT=mailto:hello@example.com

# Optional bearer token required by POST /api/push/send in production.
PUSH_SEND_TOKEN=
